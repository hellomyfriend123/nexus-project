# =====================================================================================
# Mẫu biến môi trường — COPY file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit file .env (đã có trong .gitignore).
# =====================================================================================

# --- Database (Supabase: dùng connection string dạng Session Pooler, cổng 5432) ---
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.xxxxxxxxxxxx
DB_PASSWORD=dien-mat-khau-that-vao-day
# Tên database — dùng bởi docker-compose (Postgres local)
DB_NAME=nexus

# update khi phát triển (máy cá nhân) | validate khi dùng DB chung / demo
DDL_AUTO=update

# --- Bảo mật ---
# Chuỗi ký token. PHẢI đổi thành chuỗi ngẫu nhiên >= 32 ký tự trước khi deploy.
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
TOKEN_TTL_MINUTES=480

# --- CORS (cho 2 bạn Frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Tuỳ chọn ---
SERVER_PORT=8080
SHOW_SQL=false
LOG_LEVEL=DEBUG
