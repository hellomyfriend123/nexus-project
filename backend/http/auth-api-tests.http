### REG-09: Self-registration with ADMIN role is rejected
POST {{host}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "email": "admin.attempt.{{runId}}@example.com",
  "username": "admin_try_{{runId}}",
  "password": "{{testPassword}}",
  "fullName": "Admin Attempt",
  "role": "ADMIN"
}

> {% client.test("REG-09 rejects ADMIN self-registration", function() {
    client.assert(response.status === 400 && response.body.error === "VALIDATION_ERROR", "Expected 400 VALIDATION_ERROR");
    client.assert(response.body.details.some(function(item) { return item.field === "role"; }), "Expected role violation");
}); %}

