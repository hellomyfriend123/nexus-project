### =====================================================================================
### PROJECT NEXUS — Auth API test cases: POST /register and POST /login
### Run with VS Code REST Client. Start the app and use a test database/account only.
###
### IMPORTANT: Before the first run, change @runId to a value not used in this database.
### Registration cases create persistent users; use a fresh @runId on each complete rerun.
### Cases that intentionally register duplicates must run after the matching success case.
###
### Expected error contract: { status, error, message, path, details }
### =====================================================================================

@host = http://localhost:8080
@contentType = application/json
@runId = 20261105
@buyerEmail = auth.buyer.{{runId}}@example.com
@buyerUsername = auth_buyer_{{runId}}
@sellerEmail = auth.seller.{{runId}}@example.com
@sellerUsername = auth_seller_{{runId}}
@testPassword = TestPass@123

### -------------------------------------------------------------------------------
### REGISTER — happy paths, 201 CREATED
### -------------------------------------------------------------------------------

### REG-01: Register BUYER successfully; response must not expose password/hash
# @name registerBuyer
POST {{host}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "email": "{{buyerEmail}}",
  "username": "{{buyerUsername}}",
  "password": "{{testPassword}}",
  "fullName": "Auth API Buyer",
  "phone": "0912345678",
  "role": "BUYER"
}

> {% client.test("REG-01 returns 201 and a safe BUYER profile", function() {
    client.assert(response.status === 201, "Expected HTTP 201");
    client.assert(response.body.email === request.variables.get("buyerEmail"), "Email mismatch");
    client.assert(response.body.roles.includes("BUYER"), "BUYER role missing");
    client.assert(!("password" in response.body) && !("passwordHash" in response.body), "Password data leaked");
}); %}

### REG-02: Register SELLER successfully
# @name registerSeller
POST {{host}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "email": "{{sellerEmail}}",
  "username": "{{sellerUsername}}",
  "password": "{{testPassword}}",
  "fullName": "Auth API Seller",
  "phone": "",
  "role": "SELLER"
}

> {% client.test("REG-02 returns 201 and assigns SELLER", function() {
    client.assert(response.status === 201, "Expected HTTP 201");
    client.assert(response.body.roles.includes("SELLER"), "SELLER role missing");
}); %}

### -------------------------------------------------------------------------------
### REGISTER — expected 400 VALIDATION_ERROR cases
### -------------------------------------------------------------------------------

### REG-03: Invalid email format
POST {{host}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "email": "not-an-email",
  "username": "bad_email_{{runId}}",
  "password": "{{testPassword}}",
  "fullName": "Invalid Email",
  "role": "BUYER"
}

> {% client.test("REG-03 returns VALIDATION_ERROR", function() {
    client.assert(response.status === 400 && response.body.error === "VALIDATION_ERROR", "Expected 400 VALIDATION_ERROR");
    client.assert(response.body.details.some(function(item) { return item.field === "email"; }), "Expected email violation");
}); %}

### REG-04: Password shorter than 8 characters
POST {{host}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "email": "short.pass.{{runId}}@example.com",
  "username": "short_pass_{{runId}}",
  "password": "short",
  "fullName": "Short Password",
  "role": "BUYER"
}

> {% client.test("REG-04 returns password validation error", function() {
    client.assert(response.status === 400 && response.body.error === "VALIDATION_ERROR", "Expected 400 VALIDATION_ERROR");
    client.assert(response.body.details.some(function(item) { return item.field === "password"; }), "Expected password violation");
}); %}

### REG-05: Password longer than 72 characters
POST {{host}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "email": "long.pass.{{runId}}@example.com",
  "username": "long_pass_{{runId}}",
  "password": "1234567890123456789012345678901234567890123456789012345678901234567890123",
  "fullName": "Long Password",
  "role": "BUYER"
}

> {% client.test("REG-05 returns password validation error", function() {
    client.assert(response.status === 400 && response.body.error === "VALIDATION_ERROR", "Expected 400 VALIDATION_ERROR");
    client.assert(response.body.details.some(function(item) { return item.field === "password"; }), "Expected password violation");
}); %}

### REG-06: Missing required fields / blank values
POST {{host}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "email": " ",
  "username": "",
  "password": "",
  "fullName": " ",
  "role": ""
}

> {% client.test("REG-06 returns field validation details", function() {
    client.assert(response.status === 400 && response.body.error === "VALIDATION_ERROR", "Expected 400 VALIDATION_ERROR");
    client.assert(response.body.details.length >= 5, "Expected multiple field violations");
}); %}

