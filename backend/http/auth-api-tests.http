### -------------------------------------------------------------------------------
### REGISTER — expected 409 CONFLICT cases (run after REG-01 and REG-02)
### -------------------------------------------------------------------------------

### REG-12: Duplicate email
POST {{host}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "email": "{{buyerEmail}}",
  "username": "another_{{runId}}",
  "password": "{{testPassword}}",
  "fullName": "Duplicate Email",
  "role": "BUYER"
}

> {% client.test("REG-12 returns 409 CONFLICT for duplicate email", function() {
    client.assert(response.status === 409 && response.body.error === "CONFLICT", "Expected 409 CONFLICT");
}); %}

### REG-13: Duplicate username with a different email
POST {{host}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "email": "another.user.{{runId}}@example.com",
  "username": "{{sellerUsername}}",
  "password": "{{testPassword}}",
  "fullName": "Duplicate Username",
  "role": "BUYER"
}

> {% client.test("REG-13 returns 409 CONFLICT for duplicate username", function() {
    client.assert(response.status === 409 && response.body.error === "CONFLICT", "Expected 409 CONFLICT");
}); %}

### -------------------------------------------------------------------------------
### LOGIN — expected 200, 400, and 401 cases
### -------------------------------------------------------------------------------

### LOG-01: Correct credentials; normalize email case/whitespace; capture token
# @name loginBuyer
POST {{host}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "  AUTH.BUYER.{{runId}}@EXAMPLE.COM  ",
  "password": "{{testPassword}}"
}

> {% client.test("LOG-01 returns token and user profile", function() {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.accessToken.length > 0, "Missing accessToken");
    client.assert(response.body.tokenType === "Bearer", "Expected Bearer token type");
    client.assert(response.body.user.email === request.variables.get("buyerEmail"), "User email mismatch");
});
client.global.set("authTestToken", response.body.accessToken); %}

### LOG-02: Incorrect password; same generic message as unknown email
POST {{host}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "{{buyerEmail}}",
  "password": "DefinitelyWrong@123"
}

> {% client.test("LOG-02 returns generic 401 UNAUTHORIZED", function() {
    client.assert(response.status === 401 && response.body.error === "UNAUTHORIZED", "Expected 401 UNAUTHORIZED");
    client.assert(response.body.message === "Email hoặc mật khẩu không đúng", "Unexpected credential error message");
}); %}

### LOG-03: Unknown email; same generic message as incorrect password
POST {{host}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "not.found.{{runId}}@example.com",
  "password": "{{testPassword}}"
}

> {% client.test("LOG-03 returns the same generic 401", function() {
    client.assert(response.status === 401 && response.body.error === "UNAUTHORIZED", "Expected 401 UNAUTHORIZED");
    client.assert(response.body.message === "Email hoặc mật khẩu không đúng", "Credential errors should not reveal account existence");
}); %}

### LOG-04: Empty email/password
POST {{host}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "",
  "password": " "
}

> {% client.test("LOG-04 returns 400 VALIDATION_ERROR", function() {
    client.assert(response.status === 400 && response.body.error === "VALIDATION_ERROR", "Expected 400 VALIDATION_ERROR");
    client.assert(response.body.details.length >= 2, "Expected email and password violations");
}); %}

### LOG-05: Password longer than 72 characters
POST {{host}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "{{buyerEmail}}",
  "password": "1234567890123456789012345678901234567890123456789012345678901234567890123"
}

> {% client.test("LOG-05 returns password validation error", function() {
    client.assert(response.status === 400 && response.body.error === "VALIDATION_ERROR", "Expected 400 VALIDATION_ERROR");
    client.assert(response.body.details.some(function(item) { return item.field === "password"; }), "Expected password violation");
}); %}

### LOG-06: Malformed JSON
POST {{host}}/api/v1/auth/login
Content-Type: {{contentType}}

{ "email": "broken-json", "password":

> {% client.test("LOG-06 returns 400 BAD_REQUEST", function() {
    client.assert(response.status === 400 && response.body.error === "BAD_REQUEST", "Expected 400 BAD_REQUEST");
}); %}

### -------------------------------------------------------------------------------
### Expected status/error summary
### 201: registration succeeds
### 200: login succeeds
### 400 VALIDATION_ERROR: request fields violate DTO constraints
### 400 BAD_REQUEST: malformed JSON
### 401 UNAUTHORIZED: incorrect password OR unknown email (same public message)
### 409 CONFLICT: duplicate email OR username
###
### 403 FORBIDDEN is also expected for login when an existing user has INACTIVE/BANNED
### status and supplies the correct password. Do not change a shared/production Supabase
### account to test this; use a disposable local/test database and restore its status after.
### =====================================================================================
